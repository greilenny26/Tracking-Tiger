# Copia este archivo a .env: es el único paso previo para levantar el proyecto con docker compose.
# Todos los valores son de ejemplo. Los valores reales van solo en .env, que no se versiona (RD-10).

# Servidor SMTP para el envío de la cola de correos (RF-NOT-13).
# Con SMTP_HOST=consola no se envía nada: cada correo se escribe en "docker compose logs correo" (solo para pruebas).
# Para enviar correos de verdad, pon aquí los datos de tu proveedor.
SMTP_HOST=consola
# Puerto del servidor SMTP. Normalmente 587.
SMTP_PORT=587
# Usuario de la cuenta SMTP.
SMTP_USUARIO=usuario@ejemplo.test
# Contraseña de aplicación de la cuenta SMTP (no la contraseña personal).
SMTP_CLAVE=clave-de-ejemplo
# Dirección que aparece como remitente.
SMTP_REMITENTE=usuario@ejemplo.test

# URL base con la que se arma el enlace de activación ({APP_URL_BASE}/api/auth/activar?token=...).
# Debe coincidir con la dirección donde responde la aplicación.
APP_URL_BASE=http://localhost:5000

# Primer Administrador: se crea solo al arrancar si todavía no existe (RF-CA-04).
ADMIN_CORREO_INICIAL=admin@ejemplo.test
# Mínimo 8 caracteres, con letras y números.
ADMIN_CLAVE_INICIAL=CambiaEsta123

# Ruta del archivo de la base de datos SQLite (RD-09). Con docker compose siempre es esta, en su volumen.
DB_RUTA=/datos/trackingtiger.db

# URL del Filer de SeaweedFS, donde se guarda el contenido de los documentos (RF-DOC-05).
SEAWEEDFS_URL=http://seaweedfs:8888
