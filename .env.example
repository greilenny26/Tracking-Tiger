# Servidor SMTP para el envío de la cola de correos (RF-NOT-13). Nunca escribas valores reales aquí.
# Nombre del servidor SMTP (por ejemplo, el de tu proveedor de correo). Obligatoria.
SMTP_HOST=
# Puerto del servidor SMTP. Opcional: si se deja vacía se usa 587.
SMTP_PORT=
# Usuario de la cuenta SMTP. Obligatoria.
SMTP_USUARIO=
# Contraseña de aplicación de la cuenta SMTP (no la contraseña personal). Obligatoria.
SMTP_CLAVE=
# Dirección que aparece como remitente. Opcional: si se deja vacía se usa SMTP_USUARIO.
SMTP_REMITENTE=
# URL base de la API para armar el enlace de activación ({APP_URL_BASE}/api/auth/activar?token=...).
# Debe ser http o https, sin parámetros (por ejemplo, http://localhost:5000). Obligatoria para registrar usuarios.
APP_URL_BASE=
# Correo del primer Administrador; lo usa "dotnet run -- crear-admin". Obligatoria para ese comando.
ADMIN_CORREO_INICIAL=
# Contraseña del primer Administrador (mínimo 8 caracteres, con letras y números). Obligatoria para crear-admin.
ADMIN_CLAVE_INICIAL=
